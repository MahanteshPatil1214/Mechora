# ---- Store: PostgreSQL with SQLite fallback --------------------------------
#   auto     -> try Postgres, fall back to local SQLite (offline / CI)
#   sqlite   -> always SQLite (offline demo / tests)
#   postgres -> require Postgres
STORE=postgres
DATABASE_URL=postgresql+psycopg://mechora:mechora@localhost:5432/mechora
SQLITE_FALLBACK_PATH=data/mechora_dev.db

# ---- AI (optional; leave blank to use the deterministic rule engine) ------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# auto | llm | rules  (auto = LLM when a key is present, else rules)
EXTRACTION_PROVIDER=auto
# optional supporting-only embedding model (structural similarity is primary)
EMBEDDING_MODEL=

# ---- Precursor engine ------------------------------------------------------
FAMILY_ASSIGN_THRESHOLD=0.65
EMBEDDING_BLEND=0.05

# ---- API --------------------------------------------------------------------
APP_NAME=MECHORA API
API_V1_PREFIX=/api/v1
DEBUG=false

# ---- Security / authentication (MVP demo bearer-token auth) -----------------
# Every /api/v1 data route requires a bearer token issued by POST /auth/login.
# The demo password is verified against a PBKDF2-HMAC-SHA256 hash and is never
# stored, logged, or returned by the API. Use only demo credentials here.
AUTH_ENABLED=true
AUTH_EMAIL=hse.analyst@oilindia.in
AUTH_PASSWORD=mechora2026
# Preferred in any shared/CI environment: pre-computed hash instead of a
# plaintext password (format: pbkdf2_sha256$<rounds>$<salt-hex>$<hash-hex>).
# AUTH_PASSWORD_HASH=
# HMAC signing secret for session tokens. Leave blank to auto-generate an
# in-memory secret at startup (sessions reset on restart).
# AUTH_SECRET=
AUTH_TOKEN_TTL_HOURS=8
# AUTH_MAX_ATTEMPTS=10
# AUTH_LOCKOUT_SECONDS=300